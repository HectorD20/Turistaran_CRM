{
  "name": "turistaran-crm-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "db:check": "node --env-file-if-exists=.env scripts/check-db.js",
    "db:local:setup": "node scripts/local-db.js setup",
    "db:local:start": "node scripts/local-db.js start",
    "db:local:stop": "node scripts/local-db.js stop",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.1"
  }
}
